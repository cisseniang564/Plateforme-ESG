# ============================================================
# ESGFlow Backend — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs réelles
# IMPORTANT: Ne jamais commiter .env dans git
# Pour générer SECRET_KEY : python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ─── Base de données ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/esgflow_dev

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Sécurité ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ENCRYPTION_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
APP_NAME=ESGFlow
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
RELOAD=true
LOG_LEVEL=DEBUG
API_DOCS_ENABLED=true

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=ESGFlow

# ─── Email SMTP (optionnel) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@esgflow.com
EMAILS_FROM_NAME=ESGFlow

# ─── Upload ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ─── Stripe (facturation) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STARTER_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_STARTER_YEARLY=price_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_PRO_YEARLY=price_CHANGE_ME

# ─── OpenAI / IA ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
ML_DEFAULT_OBJECTIVE_PCT=-30.0
ML_FORECAST_HORIZON_MONTHS=12
FEATURE_ML_PREDICTIONS_ENABLED=false
FEATURE_AI_RECOMMENDATIONS_ENABLED=false

# ─── Climatiq ────────────────────────────────────────────────
CLIMATIQ_API_KEY=CHANGE_ME

# ─── Carbon Interface ─────────────────────────────────────────
CARBON_INTERFACE_API_KEY=CHANGE_ME

# ─── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── S3 / MinIO ───────────────────────────────────────────────
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=esgflow-uploads
S3_ENDPOINT_URL=

# ─── Frontend ────────────────────────────────────────────────
APP_URL=http://localhost:3000
TRIAL_DAYS=14
