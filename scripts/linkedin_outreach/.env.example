# ESG Flow — LinkedIn outreach helper
# Copy this file to .env and fill in your values.

# ── Your identity (signature) ────────────────────────────────────────────────
SENDER_FIRST_NAME=Cisse
SENDER_LAST_NAME=Niang
SENDER_TITLE=Fondateur ESG Flow
CALENDLY_LINK=https://calendly.com/your-handle/decouverte-esg

# ── Snov.io API (free tier: 50 emails/month) ────────────────────────────────
# Get yours at https://app.snov.io/account/api-settings
SNOV_USER_ID=
SNOV_API_SECRET=

# ── Optional: Apollo.io API (60 emails/month free) ──────────────────────────
APOLLO_API_KEY=

# ── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_FOLLOWUP_DAY_1=5
DEFAULT_FOLLOWUP_DAY_2=12
