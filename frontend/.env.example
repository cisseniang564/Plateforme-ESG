# ============================================================
# ESGFlow Frontend — Variables Vite
# Copiez ce fichier en .env et remplissez vos valeurs réelles
# IMPORTANT: Ne jamais commiter .env dans git
# ============================================================

# URL de l'API backend
VITE_API_URL=http://localhost:8000/api/v1

# Environnement
VITE_APP_ENV=development

# Stripe (clé publique uniquement)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# Sentry (optionnel)
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_AI_INSIGHTS=false
VITE_ENABLE_ML_PREDICTIONS=false
